SELECT VIRUS_SCAN('MariaDB') AS scan_result;
SELECT VIRUS_SCAN(NULL) IS NULL AS null_result;

SELECT COUNT(*) AS status_variables
FROM INFORMATION_SCHEMA.GLOBAL_STATUS
WHERE VARIABLE_NAME LIKE 'VIRUSCAN_%';

SELECT COUNT(*) AS matches_before
FROM INFORMATION_SCHEMA.VIRUSCAN_MATCHES;

--replace_regex /[A-Za-z0-9_.-]*[Ee]icar[A-Za-z0-9_.-]*/EICAR/
SELECT VIRUS_SCAN(
'X5O!P%@AP[4\\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*'
) AS scan_result;

--replace_regex /[A-Za-z0-9_.-]*[Ee]icar[A-Za-z0-9_.-]*/EICAR/
SELECT VIRUS, USER, HOST
FROM INFORMATION_SCHEMA.VIRUSCAN_MATCHES;
